// Copy to Secrets.xcconfig (same folder) and edit. Secrets.xcconfig is gitignored.
// $() keeps xcconfig from reading the // as a comment
SERVER_BASE_URL = http:/$()/localhost:8000

// Meta Wearables DAT (stage 2). Developer Mode works with META_APP_ID empty/0.
META_APP_ID =
CLIENT_TOKEN =
DEVELOPMENT_TEAM =
