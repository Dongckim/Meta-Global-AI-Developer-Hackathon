{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pip record snapshot",
  "description": "record.json shape as served by /record and /events. Top level and node identities are strict; nodes tolerate additive keys. Bump api_version on any change here.",
  "type": "object",
  "required": ["epoch", "version", "view", "plan", "step_index", "done", "excluded", "redo",
               "notes", "tips", "timers", "stamps", "cards", "recent"],
  "properties": {
    "bench": {
      "type": "object",
      "required": ["wells", "legend", "rows"],
      "description": "Served snapshots and run details only: what the bench draws from the run so far. wells: well -> done (filled in its group) / now (a target of this step not done in it) / skipped (passed over unmarked, never done since) / excluded; others are untouched. legend: wells per condition. rows: the last steps passed (Done).",
      "properties": {
        "wells": {"type": "object", "additionalProperties": {"enum": ["done", "now", "skipped", "excluded"]}},
        "legend": {"type": "array", "items": {"type": "object", "required": ["key", "label", "n"],
                   "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "n": {"type": "integer"}}}},
        "rows": {"type": "array", "items": {"type": "object", "required": ["wells", "name", "state"],
                 "properties": {"wells": {"type": "string"}, "name": {"type": "string"}, "state": {"enum": ["done"]}}}}
      }
    },
    "skipped": {
      "type": "array",
      "description": "Wells a step was left without (the person chose Skip them): one entry per well and step.",
      "items": {"type": "object", "required": ["step", "well"],
                "properties": {"step": {"type": "integer"}, "well": {"type": "string"}, "ts": {"type": "number"}}}
    },
    "header": {
      "type": "object",
      "required": ["mode"],
      "description": "Served snapshots only (not the stored record): what the header draws besides Milo, `mode` on screens after the run mode was chosen (screens.json `header_mode`), else null.",
      "properties": {
        "mode": {"type": ["object", "null"],
                 "required": ["id", "label"],
                 "properties": {"id": {"type": "string"}, "label": {"type": "string"}}}
      }
    },
    "private": {
      "type": ["object", "null"],
      "required": ["state", "elapsed_s", "expected_s", "title", "line", "info"],
      "description": "Served snapshots only: the private model's wake-up, null until Private asks for it. The app draws it as is.",
      "properties": {
        "state": {"enum": ["warming", "ready", "failed"]},
        "elapsed_s": {"type": "integer"},
        "expected_s": {"type": "number", "description": "Median of recent cold starts: the ring's time scale."},
        "title": {"type": "string"},
        "line": {"type": "string"},
        "info": {"type": "string"}
      }
    },
    "transcribe": {"enum": ["device", "server"],
      "description": "Served snapshots only: who turns speech into text. device (Private): the iPad, and audio stays on it."},
    "epoch": {"type": "string",
              "description": "Record lineage id: minted when record.json is created, carried across start/end, new only on data reset or server move. The app resets its stale guard on change."},
    "version": {"type": "integer"},
    "view": {
      "type": "object",
      "required": ["current", "stack", "tab", "sheet"],
      "properties": {
        "current": {"type": "object",
                    "required": ["screen", "target"],
                    "properties": {"screen": {"type": "string"},
                                   "target": {"type": "string"}}},
        "stack": {"type": "array",
                  "items": {"type": "object",
                            "required": ["screen", "target"],
                            "properties": {"screen": {"type": "string"},
                                           "target": {"type": "string"}}}},
        "tab": {"type": "string"},
        "sheet": {"type": "object",
                  "required": ["name", "target"],
                  "properties": {"name": {"type": "string"},
                                 "target": {"type": "string"}}}
      }
    },
    "run": {
      "type": ["object", "null"],
      "required": ["run_id", "started_at"],
      "properties": {
        "run_id": {"type": "string"},
        "protocol_id": {"type": ["string", "null"]},
        "protocol_name": {"type": ["string", "null"]},
        "started_at": {"type": "number"},
        "label": {"type": "string", "description": "Display label (server/labels.py); never the run id."}
      }
    },
    "plan": {
      "type": "object",
      "required": ["conditions", "steps"],
      "properties": {
        "conditions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "treatments", "replicates", "wells"],
            "properties": {
              "label": {"type": "string"},
              "abbr": {"type": "string", "description": "Plate letters, <= 3 chars (labels.condition_abbrs)."},
              "treatments": {"type": "array", "items": {"type": "string"}},
              "replicates": {"type": "integer"},
              "wells": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "text", "wells"],
            "properties": {
              "kind": {"type": "string"},
              "text": {"type": "string"},
              "short_title": {"type": "string", "description": "Screen title, <= 4 words (labels.step_short_title)."},
              "minutes": {"type": ["number", "null"]},
              "temp_c": {"type": ["number", "null"]},
              "tip": {"type": ["string", "null"]},
              "caution": {"type": ["string", "null"]},
              "quote": {"type": "string"},
              "quote_page": {"type": ["integer", "null"]},
              "wells": {"type": "array", "items": {"type": "string"}},
              "pipette": {
                "type": ["object", "null"],
                "required": ["liquid", "wells"],
                "properties": {
                  "liquid": {"type": "string"},
                  "volume": {"type": ["number", "null"]},
                  "unit": {"type": ["string", "null"]},
                  "wells": {"type": "array", "items": {"type": "string"}},
                  "target_label": {"type": "string"}
                }
              }
            }
          }
        },
        "backups": {"type": "array", "items": {"type": "string"}}
      }
    },
    "step_index": {"type": "integer"},
    "done": {
      "type": "array",
      "description": "Per-step done log, one entry per (step, well), sorted by step then well. step is 1-based. Exclusions stay per well across steps.",
      "items": {
        "type": "object",
        "required": ["step", "well", "source", "ts"],
        "properties": {
          "step": {"type": "integer"},
          "well": {"type": "string"},
          "source": {"type": "string"},
          "ts": {"type": "number"}
        }
      }
    },
    "excluded": {"type": "object", "additionalProperties": {"type": "string"}},
    "redo": {"type": "object", "additionalProperties": {"type": "string"}},
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "target", "text", "ts"],
        "properties": {
          "id": {"type": "string"},
          "target": {"type": "string"},
          "text": {"type": "string"},
          "raw": {"type": "string"},
          "ts": {"type": "number"},
          "route": {"type": "string"},
          "source": {"enum": ["voice", "tap", "typed"], "description": "How the note came in (absent on older notes)."},
          "step": {"type": "integer", "description": "1-based step the note was taken in (absent on older notes)."},
          "wells": {"type": "array", "items": {"type": "string"}},
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "ts"],
              "properties": {"text": {"type": "string"}, "ts": {"type": "number"}}
            }
          }
        }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "step": {"type": "string"},
          "text": {"type": "string"},
          "ts": {"type": "number"},
          "route": {"type": "string"}
        }
      }
    },
    "timers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "minutes", "started_at", "wells"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "minutes": {"type": "number"},
          "on_done": {"type": ["string", "null"]},
          "started_at": {"type": "number"},
          "step": {"type": "string"},
          "wells": {"type": "string"},
          "step_index": {"type": "integer",
                         "description": "The step the timer was set on (0-based)."},
          "chip": {"type": "string",
                   "description": "The header chip's name: that step's short title (<= 4 words). The app draws it as is."}
        }
      }
    },
    "timer_log": {
      "type": "array",
      "description": "Timers that ended or were cancelled, with their actual seconds (timers leave `timers` a minute after they end); hand off reads a timed step's real time here.",
      "items": {"type": "object", "required": ["step_index", "duration_s", "status"],
                "properties": {"step_index": {"type": ["integer", "null"]}, "label": {"type": ["string", "null"]},
                               "planned_s": {"type": "number"}, "duration_s": {"type": "number"},
                               "started_at": {"type": "number"}, "ended_at": {"type": "number"},
                               "status": {"enum": ["done", "cancelled"]}}}
    },
    "stamps": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["source", "ts"],
        "properties": {"source": {"type": "string"}, "ts": {"type": "number"}}
      }
    },
    "cards": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "kind", "question", "ts"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"type": "string"},
          "question": {"type": "string", "description": "Spoken."},
          "title": {"type": "string", "description": "Shown big (pip_voice.json cards)."},
          "detail": {"type": ["string", "null"], "description": "Shown small under the title."},
          "ts": {"type": "number"},
          "payload": {"type": "object"}
        }
      }
    },
    "handoff": {
      "type": ["object", "null"],
      "description": "Served snapshots only: the finished run a hand off screen shows (docs/design/handoff.md), else null. summary is the import review's summary shape, rows carrying plan, run and changes (each with its record event); stage, while approved: generating | simulating | fixing | passed | needs_you.",
      "required": ["run_id", "summary", "approved", "stage", "meta"],
      "properties": {
        "run_id": {"type": "string"}, "label": {"type": "string"}, "approved": {"type": "boolean"},
        "stage": {"enum": [null, "generating", "simulating", "fixing", "passed", "needs_you"]},
        "attempt": {"type": "integer"}, "error": {"type": "string"}, "check": {"type": ["object", "null"]},
        "code": {"type": "string"}, "csv": {"type": "string"}, "exported": {"type": ["number", "null"]},
        "steps": {"type": "array", "description": "The approved as-run steps (n, title, kind transfer | delay, wells, volume_ul, pipette, seconds, comment); empty unless approved."},
        "liquids": {"type": "array", "description": "The reservoir: each liquid's name, well, volume_ul and color; empty unless approved."},
        "meta": {"type": "object"},
        "summary": {"type": "object", "required": ["rows", "others", "of", "changed"],
                    "properties": {
                      "rows": {"type": "array", "items": {
                        "type": "object",
                        "required": ["n", "index", "title", "detail", "flagged", "reason", "quote", "plan", "run", "changes"],
                        "properties": {"changes": {"type": "array", "items": {
                          "type": "object", "required": ["kind", "wells", "text", "event"],
                          "properties": {"kind": {"enum": ["excluded", "skipped", "not_marked", "redo", "off_plan", "timer"]}}}}}}},
                      "others": {"type": "array"}, "of": {"type": "integer"}, "changed": {"type": "integer"}}}
      }
    },
    "draft": {
      "type": ["object", "null"],
      "required": ["plan"],
      "properties": {
        "plan": {"type": "object"},
        "errors": {"type": "array"},
        "review": {"type": "array"},
        "meta": {"type": "object"}
      }
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ts"],
        "properties": {
          "route": {"type": "string"},
          "action": {"type": "string"},
          "wells": {"type": "array", "items": {"type": "string"}},
          "ts": {"type": "number"}
        }
      }
    }
  }
}
