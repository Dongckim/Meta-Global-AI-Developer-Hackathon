{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live conversation WebSocket messages (/voice/live)",
  "description": "App -> server: a `start` text frame, binary PCM16 LE mono 16 kHz frames (silence while the agent speaks), `tts` {speaking} when the agent starts/stops talking (window clock pause), and optionally `end`. Server -> app: the messages below. Bump api_version on any change here.",
  "$defs": {
    "start": {"type": "object", "required": ["type"], "properties": {"type": {"const": "start"}, "session": {"type": "string"}}},
    "end": {"type": "object", "required": ["type"], "properties": {"type": {"const": "end"}}},
    "tts": {"type": "object", "required": ["type", "speaking"], "properties": {"type": {"const": "tts"}, "speaking": {"type": "boolean"}}},
    "ready": {"type": "object", "required": ["type", "session_id"], "properties": {"type": {"const": "ready"}, "session_id": {"type": ["string", "null"]}}},
    "partial": {"type": "object", "required": ["type", "text"], "properties": {"type": {"const": "partial"}, "text": {"type": "string"}}},
    "ignored": {"type": "object", "required": ["type", "speaker", "text", "line"], "properties": {"type": {"const": "ignored"}, "speaker": {"type": "string"}, "text": {"type": "string"}, "line": {"type": "string"}}},
    "turn": {"type": "object", "required": ["type", "transcript", "reply", "end_session", "tool_calls", "messages", "cards", "record_version"],
             "description": "The /voice response shape plus type and end_session.",
             "properties": {"type": {"const": "turn"}, "transcript": {"type": "string"}, "reply": {"type": "string"}, "speak": {"type": "string"},
                            "end_session": {"type": "boolean"}, "tool_calls": {"type": "array"}, "messages": {"type": "array"}, "cards": {"type": "array"}, "record_version": {"type": "integer"}}},
    "stage": {"type": "object", "required": ["type", "stage"],
              "description": "Where the owner's turn is (server api._stage, the one place); turns outside a live session get the same object on /events as kind 'stage'. The app's voice state follows these. `say` is a line to speak once (Looking it up. / Still looking…); failed `reason`: timeout / no_source / canceled / error / an exception name.",
              "properties": {"type": {"const": "stage"}, "stage": {"enum": ["heard", "thinking", "searching", "summarizing", "done", "failed"]},
                             "text": {"type": "string"}, "query": {"type": "string"}, "search_id": {"type": "string"}, "say": {"type": "string"},
                             "reply": {"type": "string"}, "reason": {"type": "string"}}},
    "ping": {"type": "object", "required": ["type"], "description": "Keepalive every HEARTBEAT_S (15 s); the app closes a link silent for 45 s.", "properties": {"type": {"const": "ping"}}},
    "error": {"type": "object", "required": ["type", "message"], "properties": {"type": {"const": "error"}, "message": {"type": "string"}}},
    "closed": {"type": "object", "required": ["type", "code", "reason", "why"], "properties": {"type": {"const": "closed"}, "code": {"type": ["integer", "null"]}, "reason": {"type": "string"}, "why": {"enum": ["window", "max_duration", "end_session", "client", "server", "error"]}}}
  },
  "oneOf": [{"$ref": "#/$defs/ready"}, {"$ref": "#/$defs/partial"}, {"$ref": "#/$defs/ignored"}, {"$ref": "#/$defs/turn"}, {"$ref": "#/$defs/stage"}, {"$ref": "#/$defs/ping"}, {"$ref": "#/$defs/error"}, {"$ref": "#/$defs/closed"}]
}
